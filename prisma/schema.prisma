generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum idType {
  CC
  TI
  CE
  NIT
}

model Provider {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  firstName String
  lastName  String
  email      String
  idType   idType
  idNum    Int
  phone      Int
  active  Boolean @default(true)
  createdAt DateTime @default(now())
  products      MilkRouteLog[]
}

model MilkRouteLog {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  providerId String @db.ObjectId
  provider   Provider @relation(fields: [providerId], references: [id])
  quantity     Int
  createdAt  DateTime @default(now())

  // a provider can only have one milk log per day
  @@unique([providerId, createdAt])
}

enum unit {
  Lts
  Kg
  Und
}

model Product {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  unit     unit
  name       String
  createdAt DateTime @default(now())
  logs       ProductLog[]
}

model ProductLog {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  productId  String @db.ObjectId
  product    Product @relation(fields: [productId], references: [id])
  quantity     Int
  createdAt  DateTime @default(now())
}

enum user_role {
  ADMIN
  USER
}

model User {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  username String @unique
  password String
  role user_role
}

model Client {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  idType    idType
  idNum     String
  phone     String?
  email     String?
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  invoices  ClientInvoice[]

  @@unique([idType, idNum])
}

enum invoice_status {
  ACTIVA
  ANULADA
}

model ClientInvoice {
  id         String         @id @default(auto()) @map("_id") @db.ObjectId
  number     Int            @unique
  clientId   String         @db.ObjectId
  client     Client         @relation(fields: [clientId], references: [id])
  concept    String
  amount     Int
  // sum of the invoice payments, kept in sync on every payment so the balance check is atomic
  paidAmount Int            @default(0)
  issueDate  DateTime       @default(now())
  status     invoice_status @default(ACTIVA)
  notes      String?
  createdAt  DateTime       @default(now())
  payments   ClientPayment[]
}

enum payment_method {
  EFECTIVO
  TRANSFERENCIA
  OTRO
}

model ClientPayment {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  invoiceId String         @db.ObjectId
  invoice   ClientInvoice  @relation(fields: [invoiceId], references: [id])
  amount    Int
  method    payment_method
  date      DateTime       @default(now())
  reference String?
  createdAt DateTime       @default(now())
}

// sequential counters (e.g. client invoice numbers)
model Counter {
  id    String @id @map("_id")
  value Int
}
