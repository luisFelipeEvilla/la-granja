generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum idType {
  CC
  TI
  CE
  NIT
}

model Provider {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  firstName String
  lastName  String
  email      String
  idType   idType
  idNum    Int
  phone      Int
  active  Boolean @default(true)
  createdAt DateTime @default(now())
  products      MilkRouteLog[]
}

model MilkRouteLog {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  providerId String @db.ObjectId
  provider   Provider @relation(fields: [providerId], references: [id])
  quantity     Int
  createdAt  DateTime @default(now())

  // a provider can only have one milk log per day
  @@unique([providerId, createdAt])
}

enum unit {
  Lts
  Kg
  Und
}

model Product {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  unit     unit
  name       String
  createdAt DateTime @default(now())
  logs       ProductLog[]
}

model ProductLog {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  productId  String @db.ObjectId
  product    Product @relation(fields: [productId], references: [id])
  quantity     Int
  createdAt  DateTime @default(now())
}

enum user_role {
  ADMIN
  USER
}

model User {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  username String @unique
  password String
  role user_role
}

model Client {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  idType    idType
  idNum     String
  phone     String?
  email     String?
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  invoices  ClientInvoice[]
  reminders ClientReminder[]
  receipts  ClientReceipt[]

  @@unique([idType, idNum])
}

enum invoice_status {
  ACTIVA
  ANULADA
}

// product line of a sales invoice; name and unit are copied so past invoices don't change
type InvoiceItem {
  productId String @db.ObjectId
  name      String
  unit      unit
  quantity  Float
  unitPrice Int
  total     Int
}

model ClientInvoice {
  id         String         @id @default(auto()) @map("_id") @db.ObjectId
  number     Int            @unique
  clientId   String         @db.ObjectId
  client     Client         @relation(fields: [clientId], references: [id])
  items      InvoiceItem[]
  // invoice total: sum of the item totals
  amount     Int
  // sum of the invoice payments, kept in sync on every payment so the balance check is atomic
  paidAmount Int            @default(0)
  issueDate  DateTime       @default(now())
  status     invoice_status @default(ACTIVA)
  notes      String?
  createdAt  DateTime       @default(now())
  // set when the client signs it; a signed invoice can no longer be edited
  signedAt   DateTime?
  payments   ClientPayment[]
  attachments InvoiceAttachment[]
  signatureRequest InvoiceSignatureRequest?
}

enum payment_method {
  EFECTIVO
  TRANSFERENCIA
  OTRO
}

model ClientPayment {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  invoiceId String         @db.ObjectId
  invoice   ClientInvoice  @relation(fields: [invoiceId], references: [id])
  amount    Int
  method    payment_method
  date      DateTime       @default(now())
  reference String?
  createdAt DateTime       @default(now())
  // set when the payment is the share of an account payment (abono a cuenta) applied to this invoice
  receiptId String?        @db.ObjectId
  receipt   ClientReceipt? @relation(fields: [receiptId], references: [id])
}

// payment a client makes against their total balance (abono a cuenta); it is split into one
// ClientPayment per invoice it covers, so invoice balances and reports keep reading payments
model ClientReceipt {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  clientId  String         @db.ObjectId
  client    Client         @relation(fields: [clientId], references: [id])
  amount    Int
  method    payment_method
  date      DateTime       @default(now())
  reference String?
  createdAt DateTime       @default(now())
  payments  ClientPayment[]
}

// sequential counters (e.g. client invoice numbers)
model Counter {
  id    String @id @map("_id")
  value Int
}


enum reminder_channel {
  WHATSAPP
}

// payment reminder sent to a client, kept as a log
model ClientReminder {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  clientId       String           @db.ObjectId
  client         Client           @relation(fields: [clientId], references: [id])
  channel        reminder_channel @default(WHATSAPP)
  // balance and invoices the reminder was about, at the time it was sent
  balance        Int
  invoiceNumbers Int[]
  message        String
  sentAt         DateTime         @default(now())
}


// evidence image of an invoice; `key` is the path in the storage provider (never a URL)
model InvoiceAttachment {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  invoiceId   String        @db.ObjectId
  invoice     ClientInvoice @relation(fields: [invoiceId], references: [id])
  key         String
  name        String
  contentType String
  size        Int
  createdAt   DateTime      @default(now())
}

enum signature_event_type {
  SENT
  OPENED
  SIGNED
  REVOKED
}

type SignatureEvent {
  type         signature_event_type
  at           DateTime
  ip           String?
  userAgent    String?
  // REVOKED: who voided the signature, why, and which signature image it was (kept for audit)
  actor        String?
  reason       String?
  signatureKey String?
}

// public signing link of an invoice and its audit trail (sent, opened, signed)
model InvoiceSignatureRequest {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  invoiceId       String           @unique @db.ObjectId
  invoice         ClientInvoice    @relation(fields: [invoiceId], references: [id])
  token           String           @unique
  createdAt       DateTime         @default(now())
  events          SignatureEvent[]
  openCount       Int              @default(0)
  firstOpenedAt   DateTime?
  lastOpenedAt    DateTime?
  signedAt        DateTime?
  signatureKey    String?
  signerIp        String?
  signerUserAgent String?
}

// sign-in attempts used to throttle password guessing (per username and per IP)
model LoginAttempt {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  username  String
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([username, createdAt])
  @@index([ip, createdAt])
}
